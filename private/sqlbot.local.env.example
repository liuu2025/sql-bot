# Copy to private/sqlbot.local.env and fill every value locally.
SQLBOT_POSTGRES_USER=root
SQLBOT_POSTGRES_DB=sqlbot
SQLBOT_POSTGRES_PASSWORD=replace-with-a-random-local-password
SQLBOT_DB_URL=postgresql+psycopg://root:replace-with-url-encoded-password@sqlbot-local-pg:5432/sqlbot
SQLBOT_SECRET_KEY=replace-with-at-least-32-random-bytes
SQLBOT_DEFAULT_PWD=replace-with-a-random-initial-admin-password
